@model IEnumerable<Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="page-title">
    <div>
        <h1 class="h3 mb-1">Categories</h1>
        <p class="text-muted mb-0">Maintain issue categories for employee tickets.</p>
    </div>
</div>

<div class="content-panel mb-3">
    <h2 class="h5">Add Category</h2>
    <form asp-action="SaveCategory" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="CategoryId" value="0" />
        <div class="col-md-4">
            <label class="form-label" for="CategoryName">Name</label>
            <input id="CategoryName" name="CategoryName" class="form-control" />
        </div>
        <div class="col-md-5">
            <label class="form-label" for="CategoryDescription">Description</label>
            <input id="CategoryDescription" name="Description" class="form-control" />
        </div>
        <div class="col-md-1 form-check">
            <input type="hidden" name="IsActive" value="false" />
            <input id="CategoryActive" name="IsActive" value="true" class="form-check-input" type="checkbox" checked />
            <label class="form-check-label" for="CategoryActive">Active</label>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">Save</button>
        </div>
    </form>
</div>

<div class="content-panel">
    <div class="vstack gap-2">
        @foreach (var category in Model)
        {
            <form asp-action="SaveCategory" method="post" class="admin-row">
                <input type="hidden" name="CategoryId" value="@category.CategoryId" />
                <input name="CategoryName" class="form-control" value="@category.CategoryName" />
                <input name="Description" class="form-control" value="@category.Description" />
                <label class="form-check">
                    <input type="hidden" name="IsActive" value="false" />
                    <input name="IsActive" value="true" class="form-check-input" type="checkbox" checked="@category.IsActive" />
                    <span class="form-check-label">Active</span>
                </label>
                <button class="btn btn-outline-primary" type="submit">Save</button>
            </form>
        }
    </div>
</div>
