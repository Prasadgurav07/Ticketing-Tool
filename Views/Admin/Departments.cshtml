@model IEnumerable<Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-title">
    <div>
        <h1 class="h3 mb-1">Departments</h1>
        <p class="text-muted mb-0">Maintain business departments used for routing tickets.</p>
    </div>
</div>

<div class="content-panel mb-3">
    <h2 class="h5">Add Department</h2>
    <form asp-action="SaveDepartment" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="DepartmentId" value="0" />
        <div class="col-md-4">
            <label class="form-label" for="DepartmentName">Name</label>
            <input id="DepartmentName" name="DepartmentName" class="form-control" />
        </div>
        <div class="col-md-5">
            <label class="form-label" for="Description">Description</label>
            <input id="Description" name="Description" class="form-control" />
        </div>
        <div class="col-md-1 form-check">
            <input type="hidden" name="IsActive" value="false" />
            <input id="IsActive" name="IsActive" value="true" class="form-check-input" type="checkbox" checked />
            <label class="form-check-label" for="IsActive">Active</label>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">Save</button>
        </div>
    </form>
</div>

<div class="content-panel">
    <div class="vstack gap-2">
        @foreach (var department in Model)
        {
            <form asp-action="SaveDepartment" method="post" class="admin-row">
                <input type="hidden" name="DepartmentId" value="@department.DepartmentId" />
                <input name="DepartmentName" class="form-control" value="@department.DepartmentName" />
                <input name="Description" class="form-control" value="@department.Description" />
                <label class="form-check">
                    <input type="hidden" name="IsActive" value="false" />
                    <input name="IsActive" value="true" class="form-check-input" type="checkbox" checked="@department.IsActive" />
                    <span class="form-check-label">Active</span>
                </label>
                <button class="btn btn-outline-primary" type="submit">Save</button>
            </form>
        }
    </div>
</div>
