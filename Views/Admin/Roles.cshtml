@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Roles";
}

<div class="page-title">
    <div>
        <h1 class="h3 mb-1">Roles</h1>
        <p class="text-muted mb-0">Create application roles for authorization.</p>
    </div>
</div>

<div class="content-panel mb-3">
    <h2 class="h5">Add Role</h2>
    <form asp-action="CreateRole" method="post" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="roleName">Role Name</label>
            <input id="roleName" name="roleName" class="form-control" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">Save</button>
        </div>
    </form>
</div>

<div class="content-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Role Id</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <td><code>@role.Id</code></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
