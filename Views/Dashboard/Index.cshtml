@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-title">
    <div>
        <h1 class="h3 mb-1">Employee Dashboard</h1>
        <p class="text-muted mb-0">Your ticket activity and recent requests.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Tickets" asp-action="Create">Create Ticket</a>
</div>

<partial name="_DashboardMetrics" model="Model" />

<div class="content-panel">
    <div class="row">
        <div class="p-4">
    <div class="panel">
        <div class="panel-heading">
            <h2 class="h5 mb-0">Recent Tickets</h2>
            <a asp-controller="Tickets" asp-action="Index">View all</a>
        </div>
        <partial name="_TicketTable" model="Model.RecentTickets" />
    </div>
    </div>
    </div>
</div>
