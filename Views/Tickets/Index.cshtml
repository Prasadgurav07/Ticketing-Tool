@model TicketFilterViewModel

@{
    ViewData["Title"] = "Tickets";
}

<div class="page-title">
    <div>
        <h1 class="h3 mb-1">Tickets</h1>
        <p class="text-muted mb-0">Search and filter ticket activity.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create Ticket</a>
</div>

<div class="content-panel">
    <div class="row">
        <div class="p-4">
    <form method="get" class="row g-3 align-items-end td-filter-form">
        <div class="col-12">
            <p class="td-eyebrow">Filters</p>
        </div>

        <div class="col-md-6 col-xl-3">
            <label asp-for="Search" class="form-label"></label>
            <input asp-for="Search" class="form-control" placeholder="Ticket number or subject" />
        </div>
        <div class="col-md-6 col-xl-2">
            <label asp-for="StatusId" class="form-label">Status</label>
            <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-6 col-xl-2">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-6 col-xl-2">
            <label asp-for="PriorityId" class="form-label">Priority</label>
            <select asp-for="PriorityId" asp-items="Model.Priorities" class="form-select">
                <option value="">All priorities</option>
            </select>
        </div>
        <div class="col-md-6 col-xl-3">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                <option value="">All departments</option>
            </select>
        </div>
        <div class="col-md-6 col-xl-3">
            <label asp-for="TeamId" class="form-label">Team</label>
            <select asp-for="TeamId" asp-items="Model.Teams" class="form-select">
                <option value="">All teams</option>
            </select>
        </div>
        @if (Model.Agents.Any())
        {
            <div class="col-md-6 col-xl-3">
                <label asp-for="AssignedToId" class="form-label">Assigned Agent</label>
                <select asp-for="AssignedToId" asp-items="Model.Agents" class="form-select">
                    <option value="">All agents</option>
                </select>
            </div>
        }
        <div class="col-md-6 col-xl-2">
            <label asp-for="FromDate" class="form-label">From</label>
            <input asp-for="FromDate" class="form-control" type="date" />
        </div>
        <div class="col-md-6 col-xl-2">
            <label asp-for="ToDate" class="form-label">To</label>
            <input asp-for="ToDate" class="form-control" type="date" />
        </div>
        <div class="col-md-6 col-xl-2 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>
    </div>
    </div>

</div>

<div class="content-panel" style="padding: 10px;>
    <div class="row">
        <div class="p-4">
             <div class="panel">
                 <partial name="_TicketTable" model="Model.Tickets" />
            </div>
        </div>
    </div>
</div>
